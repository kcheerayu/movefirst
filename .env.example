NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical browser origin only: localhost locally, final HTTPS domain in Vercel production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side only. Required for invitations, account lifecycle actions, and session revocation.
SUPABASE_SERVICE_ROLE_KEY=
# Local UI preview only; code ignores it when NODE_ENV=production. Do not set it in Vercel.
NEXT_PUBLIC_DEVELOPMENT_PREVIEW=false
